module Deliverance
  VERSION: String

  LOG_TIMESTAMP_FORMAT: String
  LOG_SEVERITY_WIDTH: Integer

  Error: singleton(Deliverance::Errors::Error)
  CommandNotFoundError: singleton(Deliverance::Errors::CommandNotFoundError)

  module Errors
    class Error < StandardError
    end

    class CommandNotFoundError < Error
    end
  end

  def self.env: () -> String
  def self.development?: () -> bool
  def self.logger: () -> Logger
  def self.logger=: (Logger logger) -> Logger

  module Banner
    BANNERS_DIR: String
    RESET_COLOR: String
    COLORS: Hash[Symbol, String]
    QUOTES: Array[String]

    def self.styles: () -> Array[Symbol]
    def self.banner_for: (Symbol style) -> String?
    def self.random_style: (?random: untyped) -> Symbol?
    def self.random_quote: (?random: untyped) -> String
    def self.random: (?color: bool, ?random: untyped) -> String
    def self.info_line: (?color: bool, ?random: untyped) -> String
    def self.render: (?Symbol | String? style, ?color: bool, ?random: untyped) -> String
  end

  module Commands
    def self.registry: () -> Hash[String, singleton(Base)]
    def self.register: (singleton(Base) command_class) -> void
    def self.unregister: (String name) -> void
    def self.find: (String | Symbol name) -> singleton(Base)?
    def self.all: () -> Array[singleton(Base)]
    def self.execute: (String | Symbol name, *untyped, ?context: Hash[Symbol, untyped], **untyped) -> untyped
    def self.reset_registry!: () -> void

    class Base
      @context: Hash[Symbol, untyped]

      def self.command_name: (?String | Symbol? name) -> String
      def self.description: (?String? desc) -> String
      def self.usage: (?String? use) -> String
      def self.aliases: (*String | Symbol names) -> Array[String]
      def self.call: (*untyped, ?context: Hash[Symbol, untyped], **untyped) -> untyped

      def initialize: (?Hash[Symbol, untyped] context) -> void
      def execute: (*untyped) -> untyped
      def run_command: (String | Symbol name, *untyped, **untyped) -> untyped
      def logger: () -> Logger
      def output: () -> untyped
      def context: () -> Hash[Symbol, untyped]

      private

      def self.default_command_name: () -> String
    end

    class Help < Base
      def execute: (?String? command_name) -> void

      private

      def list_all_commands: () -> void
      def summary_for: (singleton(Base) cmd) -> String
      def show_command_help: (String name) -> void
    end

    class Exit < Base
      def execute: (*untyped) -> void
    end

    class Scan < Base
      def execute: (?String? target, *String extra_args) -> Hash[Symbol, untyped]?

      private

      def resolve_target_path: (String? target, Array[String] extra_args) -> String?
      def discover_entries: (String path) -> Array[String]
      def build_stats: (String path, Array[String] entries) -> Hash[Symbol, untyped]
      def log_verbose_stats: (Hash[Symbol, untyped] stats) -> void
      def render_summary: (Hash[Symbol, untyped] stats) -> void
      def format_bytes: (Integer bytes) -> String
    end

    class Clear < Base
      CLEAR_CODE: String

      def execute: (*untyped) -> void
    end

    class Cve < Base
      module GhsaFetcher
        GLOBAL_API_URL: String

        def self.fetch: (String ghsa_id, ?untyped client) -> Hash[String, untyped]?
        def self.find_repo_advisory: (String ghsa_id, untyped client) -> Hash[String, untyped]?
        def self.extract_repos: (Hash[String, untyped] data) -> Array[String]
        def self.http_get: (URI::Generic uri, untyped client) -> untyped
      end

      CVE_PATTERN: Regexp
      GHSA_PATTERN: Regexp
      CVE_API_URL: String
      CVSS_KEYS: Array[String]
      SEVERITY_STYLES: Hash[String, String]

      def execute: (?String? subcommand, ?String? code, *untyped) -> Hash[Symbol, untyped]?

      private

      def handle_info: (String? raw_code) -> Hash[Symbol, untyped]?
      def detect_identifier: (String? code) -> [Symbol, String]?
      def fetch_cve: (String cve_id) -> Hash[String, untyped]?
      def fetch_ghsa: (String ghsa_id) -> Hash[String, untyped]?
      def http_client: () -> untyped
      def http_get: (URI::Generic uri) -> untyped
      def parse_cve: (String cve_id, Hash[String, untyped] data) -> Hash[Symbol, untyped]
      def parse_ghsa: (String ghsa_id, Hash[String, untyped] data) -> Hash[Symbol, untyped]
      def extract_ghsa_packages: (Hash[String, untyped] data) -> String?
      def extract_cvss: (Array[Hash[String, untyped]]? metrics) -> [String, untyped]
      def render_advisory: (Hash[Symbol, untyped] info) -> void
      def render_metadata: (Hash[Symbol, untyped] info) -> void
      def render_severity: (Hash[Symbol, untyped] info) -> void
      def format_state: (String state) -> String
      def show_usage: () -> nil
    end
  end

  class CLI
    PROMPT_FORMAT: String
    EXIT_HINT: String
    DEFAULT_HISTORY_FILE: String
    MAX_HISTORY_ENTRIES: Integer

    @input_reader: untyped
    @logger: Logger
    @output: untyped
    @history_file: String?
    @banner: bool
    @line_cnt: Integer

    def self.start: () -> void
    def initialize: (?input_reader: untyped, ?logger: Logger, ?output: untyped, ?history_file: String?, ?banner: bool) -> void
    def run: () -> void

    private

    def print_banner: () -> void
    def repl_loop: () -> void
    def record_history: (String input) -> void
    def load_history: () -> void
    def save_history_to_file: () -> void
    def dispatch: (String input) -> void
    def parse_input: (String input) -> Array[String]
    def command_context: () -> Hash[Symbol, untyped]
  end
end
